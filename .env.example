# GEMINI_API_KEY: Required for server-side Gemini AI financial & market analysis.
# Automatically injected by runtime environment or configured in production .env.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where the application is hosted.
APP_URL="https://app.finotam.ir"

# Domain configuration for Finotam production deployment
PRIMARY_DOMAIN="finotam.ir"
APP_SUBDOMAIN="app.finotam.ir"
ALLOWED_ORIGINS="https://finotam.ir,https://www.finotam.ir,https://app.finotam.ir"
PORT=3000
